{
  "name": "webtolk/max",
  "description": "Pure Composer SDK for MAX Platform API",
  "type": "library",
  "license": "MIT",
  "homepage": "https://web-tolk.ru",
  "keywords": [
    "api",
    "max",
    "messenger",
    "php",
    "max-platform"
  ],
  "authors": [
    {
      "name": "Sergey Tolkachyov",
      "homepage": "https://web-tolk.ru"
    }
  ],
  "support": {
    "source": "https://github.com/WebTolk/Max-platform-PHP-SDK"
  },
  "autoload": {
    "psr-4": {
      "Webtolk\\Max\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Webtolk\\Max\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pcre": "*",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.1|^2.0",
    "psr/log": "^1.1 || ^2.0 || ^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "guzzlehttp/guzzle": "^7",
    "joomla/http": "^2.0",
    "laminas/laminas-diactoros": "^2.26"
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml"
  }
}
