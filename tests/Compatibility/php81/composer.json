{
  "name": "webtolk/max-php81-tests",
  "description": "Isolated PHP 8.1 test dependencies for the SDK source tree",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "~8.1.0",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pcre": "*",
    "guzzlehttp/guzzle": "^7",
    "laminas/laminas-diactoros": "^3.6",
    "phpunit/phpunit": "^10.5",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.1|^2.0",
    "psr/log": "^1.1 || ^2.0 || ^3.0"
  },
  "config": {
    "platform": { "php": "8.1.34" },
    "allow-plugins": false,
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Webtolk\\Max\\": "../../../src/",
      "Webtolk\\Max\\Tests\\": "../../"
    }
  }
}
